# 複製成 .env 後修改；npm start 會自動讀取。

# 伺服器連接埠
PORT=3000

# 第一次啟動時建立的管理員帳號。沒設定 ADMIN_PASSWORD 的話，系統會產生隨機密碼並顯示在啟動訊息裡。
ADMIN_USER=admin
# ADMIN_PASSWORD=請改成至少 8 個字元的密碼

# 資料庫存放的資料夾（裡面的 vote.db 就是全部資料，備份這個檔案即可）
# DATA_DIR=./data

# 正式上線、使用 HTTPS 時設為 1（登入 Cookie 會加上 Secure）
# COOKIE_SECURE=1

# 放在 Nginx／Cloudflare 等反向代理後面時設為 1（才能取得正確的來源 IP）
# TRUST_PROXY=1

# 看板更新通知的最短間隔（毫秒，預設 1500）。觀眾非常多時可以調大，例如 3000。
# NOTIFY_INTERVAL_MS=1500

# 允許 Cloudflare 等 CDN 快取公開看板資料幾秒（0 = 不允許，預設）。需搭配 CDN 的快取規則，見 deploy/README.md。
# EDGE_CACHE_SECONDS=2
