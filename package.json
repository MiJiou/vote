{
  "name": "vote-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "即時開票看板：總統大選與縣市長選舉的票數統計與公開展示",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "build:geo": "node scripts/build-geo.mjs",
    "demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/demo.ts",
    "setup:2026": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/setup-2026.ts",
    "mock:cec": "node --disable-warning=ExperimentalWarning scripts/mock-cec.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "d3-geo": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "read-excel-file": "^9.3.20",
    "taiwan-atlas": "^2021.9.20",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
